#!/usr/bin/env node

/**
 * quikleaf CLI launcher — runs the platform binary for this package's version,
 * downloading it from the GitHub release on first run (see ../install.js).
 */

const { spawnSync } = require("child_process");
const { ensureBinary } = require("../install.js");

async function main() {
  let binary;
  try {
    binary = await ensureBinary();
  } catch (e) {
    console.error(`quikleaf: ${e.message}`);
    process.exit(1);
  }
  const r = spawnSync(binary, process.argv.slice(2), { stdio: "inherit" });
  if (r.error) {
    console.error(`quikleaf: could not start ${binary}: ${r.error.message}`);
    process.exit(1);
  }
  process.exit(r.status === null ? 1 : r.status);
}

main();
