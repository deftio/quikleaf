#!/usr/bin/env node

/**
 * quikleaf CLI launcher — runs the platform binary that install.js downloaded
 * from the GitHub release for this package's version (see install.js).
 */

const { execFileSync } = require("child_process");
const path = require("path");
const fs = require("fs");

const SUPPORTED = ["darwin-arm64", "darwin-x64", "linux-x64", "win32-x64"];

function getBinaryPath() {
  const platformKey = `${process.platform}-${process.arch}`;
  if (!SUPPORTED.includes(platformKey)) {
    console.error(
      `quikleaf: unsupported platform ${platformKey}\n` +
      `Supported: ${SUPPORTED.join(", ")}\n` +
      `Download manually: https://github.com/deftio/quikleaf/releases`
    );
    process.exit(1);
  }

  const binName = process.platform === "win32" ? "quikleaf.exe" : "quikleaf";
  const binary = path.join(__dirname, "..", "bin-fallback", binName);
  if (fs.existsSync(binary)) return binary;

  console.error(
    `quikleaf: binary not found for ${platformKey} (install.js could not download it)\n` +
    `Try reinstalling: npm install -g quikleaf\n` +
    `Or download from: https://github.com/deftio/quikleaf/releases`
  );
  process.exit(1);
}

const binary = getBinaryPath();
const args = process.argv.slice(2);

try {
  execFileSync(binary, args, { stdio: "inherit" });
} catch (e) {
  if (e.status !== null) process.exit(e.status);
  throw e;
}
